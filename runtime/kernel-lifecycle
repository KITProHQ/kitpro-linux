    "repository_generation": $(json_string_or_null "${SOURCE_GENERATION:-}"),
    "kernel_path": $(json_string_or_null "${CURRENT_KERNEL_PATH:-}"),
    "kernel_sha256": $(json_string_or_null "${CURRENT_KERNEL_SHA:-}"),
