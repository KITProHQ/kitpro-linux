emit_status_human() {
    local current=${CURRENT_RELEASE:-unavailable} previous=${PREVIOUS_RELEASE:-none}
    local running=${STATUS_RUNNING:-unavailable} generation=${SOURCE_GENERATION:-unavailable}
    printf 'KITPro Linux Kernel Status\n\n'
    printf '%-25s %s\n' 'Running kernel:' "$running"
    printf '%-25s %s\n' 'Current kernel:' "$current"
    printf '%-25s %s\n' 'State:' "${STATE_STATUS:-unavailable}"
    printf '%-25s %s\n' 'Boot mode:' "$STATUS_BOOT_MODE"
    printf '%-25s %s\n\n' 'Repository generation:' "$generation"
    printf '%-25s %s\n' 'Previous known-good:' "$previous"
    printf '%-25s %s\n' 'Fallback available:' "$STATUS_FALLBACK"
    printf '%-25s %s\n' 'Fallback boot entry:' "$STATUS_PREVIOUS_ENTRY_DISPLAY"
    printf '%-25s %s\n' 'Fallback kernel:' "$STATUS_PREVIOUS_KERNEL_DISPLAY"
    printf '%-25s %s\n' 'Fallback initramfs:' "$STATUS_PREVIOUS_INITRAMFS_DISPLAY"
    printf '%-25s %s\n\n' 'Fallback modules:' "$STATUS_PREVIOUS_MODULES_DISPLAY"
    printf '%-25s %s\n' 'Candidate pending:' "$STATUS_CANDIDATE_PRESENT"
    if [[ $STATUS_CANDIDATE_PRESENT == true ]]; then
        printf '%-25s %s (%s)\n' 'Candidate kernel:' "$STATUS_CANDIDATE_RELEASE" "$STATUS_CANDIDATE_STATUS"
    fi
    printf '%-25s %s\n' 'Reboot required:' "$STATUS_REBOOT_REQUIRED"
    printf '%-25s %s\n\n' 'Metadata consistent:' "$STATUS_METADATA_VALID"
    printf 'Retention preflight:\n'
    if [[ $STATUS_ROOT_REQUIRED != null ]]; then
        printf '  %-23s %s\n' 'Root space required:' "$(status_mib "$STATUS_ROOT_REQUIRED")"
        printf '  %-23s %s\n' 'Root space available:' "$(status_mib "$STATUS_ROOT_AVAILABLE")"
        printf '  %-23s %s\n' 'ESP space required:' "$(status_mib "$STATUS_ESP_REQUIRED")"
        printf '  %-23s %s\n' 'ESP space available:' "$(status_mib "$STATUS_ESP_AVAILABLE")"
    fi
    printf '  %-23s %s\n\n' 'Next retention:' "$STATUS_RETENTION_RESULT"
    if [[ ${STATUS_VERBOSE:-false} == true && $STATUS_METADATA_VALID == true ]]; then
        printf 'Details:\n'
        printf '  Current kernel:    %s (%s)\n' "$CURRENT_KERNEL_PATH" "$CURRENT_KERNEL_SHA"
        printf '  Current initramfs: %s (%s)\n' "$CURRENT_INITRAMFS_PATH" "$CURRENT_INITRAMFS_SHA"
        printf '  Transition ID:     %s\n' "${TRANSITION_OPERATION_ID:-none}"
        printf '  Latest receipt:    %s\n\n' "${TRANSITION_RECEIPT:-none}"
    fi
    local message
    for message in "${STATUS_WARNINGS[@]}"; do printf 'WARNING: %s\n' "$message"; done
    for message in "${STATUS_ERRORS[@]}"; do printf 'ERROR: %s\n' "$message"; done
    printf '\nOverall status:          %s\n' "$STATUS_OVERALL"
}

kernel_status() {
    local output=json running_override=
    STATUS_VERBOSE=false
    if [[ ${1:-} != --json ]]; then output=human; fi
    while [[ $# -gt 0 ]]; do
        case $1 in
            --json) output=json; shift ;;
            --verbose) STATUS_VERBOSE=true; shift ;;
            --running-kernel)
                [[ $# -ge 2 ]] || { printf 'kitpro-kernel-status: --running-kernel requires a value\n' >&2; return 3; }
                running_override=$2; shift 2 ;;
            -h|--help)
                printf 'usage: kitpro-kernel-status [--json] [--verbose]\n'
                return 0
                ;;
            *) printf 'kitpro-kernel-status: unknown argument: %s\n' "$1" >&2; return 3 ;;
        esac
    done

    STATUS_TIMESTAMP=$(now)
    STATUS_WARNINGS=()
    STATUS_ERRORS=()
    STATUS_METADATA_VALID=false
    STATUS_RUNNING=$running_override
    if [[ -z $STATUS_RUNNING ]]; then
        if [[ $ROOT == / ]]; then STATUS_RUNNING=$(uname -r); else STATUS_RUNNING=unavailable; fi
    fi
    STATUS_BOOT_MODE=unavailable
    STATUS_EXPECTED_MATCH=null
    STATUS_CURRENT_KERNEL_VALID=false
    STATUS_CURRENT_INITRAMFS_VALID=false
    STATUS_CURRENT_MODULES_VALID=false
    STATUS_CURRENT_ENTRY_VALID=false
    STATUS_PREVIOUS_PRESENT=false
    STATUS_PREVIOUS_KERNEL_VALID_JSON=null
    STATUS_PREVIOUS_INITRAMFS_VALID_JSON=null
    STATUS_PREVIOUS_MODULES_VALID_JSON=null
    STATUS_PREVIOUS_ENTRY_VALID_JSON=null
    STATUS_PREVIOUS_KERNEL_DISPLAY=not-present
    STATUS_PREVIOUS_INITRAMFS_DISPLAY=not-present
    STATUS_PREVIOUS_MODULES_DISPLAY=not-present
    STATUS_PREVIOUS_ENTRY_DISPLAY=not-present
    STATUS_FALLBACK=no
    STATUS_FALLBACK_AVAILABLE=false
    STATUS_FALLBACK_REASON='No previous known-good kernel has been retained yet.'
    STATUS_CANDIDATE_PRESENT=false
    STATUS_CANDIDATE_PACKAGE=
    STATUS_CANDIDATE_RELEASE=
    STATUS_CANDIDATE_STATUS=
    STATUS_REBOOT_REQUIRED=false
    STATUS_ROOT_REQUIRED=null STATUS_ROOT_AVAILABLE=null
    STATUS_ESP_REQUIRED=null STATUS_ESP_AVAILABLE=null
    STATUS_RETENTION_RESULT=unavailable

    if status_metadata_valid; then
        STATUS_METADATA_VALID=true
        status_artifact_valid "$CURRENT_KERNEL_PATH" "$CURRENT_KERNEL_SHA" && STATUS_CURRENT_KERNEL_VALID=true
        status_artifact_valid "$CURRENT_INITRAMFS_PATH" "$CURRENT_INITRAMFS_SHA" && STATUS_CURRENT_INITRAMFS_VALID=true
        status_modules_valid "$CURRENT_MODULE_TREE" && STATUS_CURRENT_MODULES_VALID=true
        status_entry_valid "$CURRENT_BOOT_ENTRY" "$CURRENT_KERNEL_PATH" "$CURRENT_INITRAMFS_PATH" && STATUS_CURRENT_ENTRY_VALID=true
        if [[ $STATUS_CURRENT_KERNEL_VALID != true || $STATUS_CURRENT_INITRAMFS_VALID != true ||
              $STATUS_CURRENT_MODULES_VALID != true || $STATUS_CURRENT_ENTRY_VALID != true ]]; then
            status_error 'Current kernel artifacts are incomplete or invalid.'
        fi

        if [[ -n ${PREVIOUS_RELEASE:-} ]]; then
            STATUS_PREVIOUS_PRESENT=true
            STATUS_PREVIOUS_KERNEL_VALID_JSON=false
            STATUS_PREVIOUS_INITRAMFS_VALID_JSON=false
            STATUS_PREVIOUS_MODULES_VALID_JSON=false
            STATUS_PREVIOUS_ENTRY_VALID_JSON=false
            if status_artifact_valid "$PREVIOUS_KERNEL_PATH" "$PREVIOUS_KERNEL_SHA"; then
                STATUS_PREVIOUS_KERNEL_VALID_JSON=true; STATUS_PREVIOUS_KERNEL_DISPLAY=valid
            else STATUS_PREVIOUS_KERNEL_DISPLAY=invalid; fi
            if status_artifact_valid "$PREVIOUS_INITRAMFS_PATH" "$PREVIOUS_INITRAMFS_SHA"; then
                STATUS_PREVIOUS_INITRAMFS_VALID_JSON=true; STATUS_PREVIOUS_INITRAMFS_DISPLAY=valid
            else STATUS_PREVIOUS_INITRAMFS_DISPLAY=invalid; fi
            if status_modules_valid "$PREVIOUS_MODULE_TREE"; then
                STATUS_PREVIOUS_MODULES_VALID_JSON=true; STATUS_PREVIOUS_MODULES_DISPLAY=present
            else STATUS_PREVIOUS_MODULES_DISPLAY=missing; fi
            if status_entry_valid "$PREVIOUS_BOOT_ENTRY" "$PREVIOUS_KERNEL_PATH" "$PREVIOUS_INITRAMFS_PATH"; then
                STATUS_PREVIOUS_ENTRY_VALID_JSON=true; STATUS_PREVIOUS_ENTRY_DISPLAY=valid
            else STATUS_PREVIOUS_ENTRY_DISPLAY=invalid; fi
            if [[ $STATUS_PREVIOUS_KERNEL_VALID_JSON == true &&
                  $STATUS_PREVIOUS_INITRAMFS_VALID_JSON == true &&
                  $STATUS_PREVIOUS_MODULES_VALID_JSON == true &&
                  $STATUS_PREVIOUS_ENTRY_VALID_JSON == true ]]; then
                STATUS_FALLBACK=yes
                STATUS_FALLBACK_AVAILABLE=true
                STATUS_FALLBACK_REASON='All previous-known-good artifacts are valid.'
            else
                STATUS_FALLBACK=degraded
                STATUS_FALLBACK_REASON='One or more previous-known-good artifacts are missing or invalid.'
                status_warning 'Fallback is degraded. Use kitpro-rescue to inspect or repair it.'
            fi
        fi

        if [[ $STATE_STATUS == candidate ]]; then
            STATUS_CANDIDATE_PRESENT=true
            STATUS_CANDIDATE_PACKAGE=$CURRENT_PACKAGE_VERSION
            STATUS_CANDIDATE_RELEASE=$CURRENT_RELEASE
            STATUS_CANDIDATE_STATUS=$CANDIDATE_STATUS
            status_warning 'Candidate kernel is not yet known-good.'
        fi
        if [[ $TRANSITION_STAGE == reboot-pending ]]; then STATUS_REBOOT_REQUIRED=true; fi
        if [[ $STATUS_RUNNING == "$CURRENT_RELEASE" ]]; then
            STATUS_BOOT_MODE=current
            STATUS_EXPECTED_MATCH=true
        elif [[ $STATUS_PREVIOUS_PRESENT == true && $STATUS_RUNNING == "$PREVIOUS_RELEASE" ]]; then
            STATUS_BOOT_MODE=previous-known-good
            STATUS_EXPECTED_MATCH=false
            STATUS_REBOOT_REQUIRED=true
            status_warning 'Running previous-known-good kernel; operator attention is required.'
        elif [[ $STATUS_RUNNING == unavailable ]]; then
            STATUS_BOOT_MODE=unavailable
            STATUS_EXPECTED_MATCH=null
        else
            STATUS_BOOT_MODE=unexpected
            STATUS_EXPECTED_MATCH=false
            STATUS_REBOOT_REQUIRED=true
            status_error "Running kernel $STATUS_RUNNING is not tracked by kernel-state metadata."
        fi

        if [[ $STATUS_CURRENT_KERNEL_VALID == true && $STATUS_CURRENT_INITRAMFS_VALID == true &&
              $STATUS_CURRENT_MODULES_VALID == true ]]; then
            retention_space_requirements
            STATUS_ROOT_REQUIRED=$RETENTION_ROOT_REQUIRED
            STATUS_ROOT_AVAILABLE=$RETENTION_ROOT_AVAILABLE
            STATUS_ESP_REQUIRED=$RETENTION_ESP_REQUIRED
            STATUS_ESP_AVAILABLE=$RETENTION_ESP_AVAILABLE
            if (( RETENTION_ROOT_AVAILABLE >= RETENTION_ROOT_REQUIRED && RETENTION_ESP_AVAILABLE >= RETENTION_ESP_REQUIRED )); then
                STATUS_RETENTION_RESULT=ready
            else
                STATUS_RETENTION_RESULT=insufficient-space
                status_warning 'Insufficient free space to retain another previous kernel safely.'
            fi
        fi
    fi

    if (( ${#STATUS_ERRORS[@]} > 0 )); then
        STATUS_OVERALL=error; STATUS_EXIT=2
    elif (( ${#STATUS_WARNINGS[@]} > 0 )); then
        STATUS_OVERALL=warning; STATUS_EXIT=1
    else
        STATUS_OVERALL=healthy; STATUS_EXIT=0
    fi
    if [[ $output == json ]]; then emit_status_json; else emit_status_human; fi
    return "$STATUS_EXIT"
}

usage() {
    cat <<'EOF'
usage: kernel-lifecycle [--root PATH] COMMAND [ARGS]

Commands:
  initialize                   Create fresh-install candidate state
  stage                        Preserve the current known-good kernel before pacman
  activate                     Activate a distinct installed kernel as candidate
  record-successful-boot       Promote a healthy candidate or record fallback health
  validate-fallback            Validate retained fallback artifacts and entry
  repair-fallback-entry        Recreate the manual fallback entry
  refresh-current-artifacts    Refresh current ESP artifacts and boot entry
  regenerate-previous-initramfs Regenerate the retained kernel's initramfs
  status                       Report read-only kernel lifecycle status
EOF
}

if [[ ${1:-} == --root ]]; then
    [[ $# -ge 3 ]] || fail "--root requires a path and command"
    ROOT=${2%/}
    [[ -n $ROOT ]] || ROOT=/
    shift 2
fi

command=${1:-}
[[ -n $command ]] || { usage; exit 1; }
shift
case $command in
    initialize) initialize "$@" ;;
    stage) [[ $# -eq 0 ]] || fail "stage takes no arguments"; stage_transition ;;
    activate) [[ $# -eq 0 ]] || fail "activate takes no arguments"; activate_candidate ;;
    record-successful-boot) [[ $# -eq 0 ]] || fail "record-successful-boot takes no arguments"; record_successful_boot ;;
    validate-fallback) [[ $# -eq 0 ]] || fail "validate-fallback takes no arguments"; validate_fallback ;;
    repair-fallback-entry) [[ $# -eq 0 ]] || fail "repair-fallback-entry takes no arguments"; repair_fallback_entry ;;
    refresh-current-artifacts) [[ $# -eq 0 ]] || fail "refresh-current-artifacts takes no arguments"; refresh_current_artifacts ;;
    regenerate-previous-initramfs) [[ $# -eq 0 ]] || fail "regenerate-previous-initramfs takes no arguments"; regenerate_previous_initramfs ;;
    status) kernel_status "$@" ;;
    -h|--help|help) usage ;;
    *) fail "unknown command: $command" ;;
esac
