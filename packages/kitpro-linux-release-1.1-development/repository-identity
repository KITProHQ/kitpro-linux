#!/usr/bin/env python3
"""Record installed generation identity from the signed KITPro sync DB."""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import tarfile
import tempfile
from pathlib import Path

REPOSITORY_FINGERPRINT = "52BADA3613798054B7E35840DC088D21DA29F538"
MEMBER_PATTERN = re.compile(r"kitpro-linux-release-[^/]+/kitpro-generation\.json")


def expected_repository_fingerprint(release: dict) -> str:
    channel = release.get("channel")
    if channel == "development":
        qualification_fingerprint = release.get("qualification_repository_fingerprint")
        if (
            release.get("production_ready") is not False
            or not isinstance(qualification_fingerprint, str)
            or not re.fullmatch(r"[0-9A-F]{40}", qualification_fingerprint)
            or qualification_fingerprint == REPOSITORY_FINGERPRINT
            or "repository_fingerprint" in release
        ):
            raise ValueError("development repository trust binding is invalid")
        return qualification_fingerprint
    if channel == "stable":
        if (
            release.get("repository_fingerprint") != REPOSITORY_FINGERPRINT
            or "qualification_repository_fingerprint" in release
        ):
            raise ValueError("production repository trust binding is invalid")
        return REPOSITORY_FINGERPRINT
    if (
        channel is None
        and release.get("release") == "1.0"
        and release.get("generation_policy") == "current"
        and "qualification_repository_fingerprint" not in release
    ):
        return REPOSITORY_FINGERPRINT
    raise ValueError("release repository channel is invalid")


def descriptor(database: Path, expected_release: str = "1.0") -> dict:
    with tarfile.open(database, "r:*") as archive:
        entries = [
            member
            for member in archive.getmembers()
            if MEMBER_PATTERN.fullmatch(member.name)
        ]
        if len(entries) != 1 or not entries[0].isfile() or entries[0].size > 262144:
            raise ValueError("production DB generation descriptor is missing or invalid")
        value = json.load(archive.extractfile(entries[0]))
    if (
        value.get("release") != expected_release
        or value.get("schema_version") != 1
        or not re.fullmatch(
            rf"{re.escape(expected_release)}-g[0-9]{{4}}",
            value.get("generation_id", ""),
        )
    ):
        raise ValueError("invalid production generation identity")
    packages = value.get("packages", [])
    package_count = value.get("package_count")
    explicit_package_count = value.get("explicit_package_count")
    if (
        not isinstance(package_count, int)
        or not 1 <= package_count <= 4096
        or len(packages) != package_count
        or len({package["name"] for package in packages}) != package_count
    ):
        raise ValueError("production inventory package count is invalid")
    if (
        not isinstance(explicit_package_count, int)
        or not 1 <= explicit_package_count <= package_count
        or sum(package["explicit"] is True for package in packages)
        != explicit_package_count
    ):
        raise ValueError("production inventory explicit package count is invalid")
    return value


def update(root: Path = Path("/")) -> dict:
    release = json.loads((root / "usr/lib/kitpro-linux/release.json").read_text())
    release_name = release.get("release")
    if not isinstance(release_name, str) or not re.fullmatch(
        r"[0-9]+\.[0-9]+", release_name
    ):
        raise ValueError("release package identity is invalid")
    database = root / f"var/lib/pacman/sync/kitpro-{release_name}-core.db"
    expected_fingerprint = expected_repository_fingerprint(release)
    verified = subprocess.run(
        [
            "gpg",
            "--no-options",
            "--batch",
            "--no-auto-key-retrieve",
            "--no-autostart",
            "--homedir",
            str(root / "etc/pacman.d/gnupg"),
            "--status-fd",
            "1",
            "--verify",
            str(database) + ".sig",
            str(database),
        ],
        check=True,
        capture_output=True,
        text=True,
    )
    signatures = [
        line.split()[2]
        for line in verified.stdout.splitlines()
        if line.startswith("[GNUPG:] VALIDSIG ")
    ]
    if signatures != [expected_fingerprint]:
        raise ValueError("generation descriptor lacks the exact Repository signature")
    value = descriptor(database, release_name)
    installed = subprocess.run(
        ["pacman", "--root", str(root), "-Q"],
        check=True,
        capture_output=True,
        text=True,
    )
    observed = dict(line.split(maxsplit=1) for line in installed.stdout.splitlines())
    expected = {package["name"]: package["version"] for package in value["packages"]}
    if observed != expected:
        raise ValueError("installed package inventory differs from signed generation")
    destination = root / "etc/kitpro-linux-release.json"
    if destination.exists():
        previous = json.loads(destination.read_text()).get("generation")
        if previous and previous > value["generation_id"]:
            raise ValueError("refusing generation identity rollback")
    if release_name == "1.0" and release.get("generation_policy") != "current":
        raise ValueError("production release package identity is missing")
    if release_name != "1.0" and release.get("generation") != value["generation_id"]:
        raise ValueError("release package generation identity differs")
    release["generation"] = value["generation_id"]
    fd, temporary_name = tempfile.mkstemp(
        prefix=".kitpro-linux-release.", dir=destination.parent
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(release, stream, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fchmod(stream.fileno(), 0o644)
            os.fsync(stream.fileno())
        os.replace(temporary, destination)
        directory_fd = os.open(destination.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        temporary.unlink(missing_ok=True)
    return {
        "status": "passed",
        "generation": value["generation_id"],
        "package_count": value["package_count"],
    }


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path("/"))
    arguments = parser.parse_args()
    print(json.dumps(update(arguments.root), sort_keys=True))
