{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitpro.us/schemas/phase5-input-bundle-v1.json",
  "title": "KITPro Linux Phase 5 build-input bundle",
  "type": "object",
  "required": [
    "schema_version", "kind", "release", "stable_generation",
    "generation_manifest_sha256", "package_count", "artifact_set_sha256",
    "object_count", "contents_inventory_sha256", "contents", "bundle_manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "kitpro-phase5-build-input-bundle"},
    "release": {"const": "0.1-dev"},
    "stable_generation": {"type": "string", "pattern": "^0\\.1-dev-g[0-9]{4}$"},
    "generation_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package_count": {"type": "integer", "minimum": 1},
    "artifact_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "object_count": {"type": "integer", "minimum": 1},
    "contents_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contents": {"type": "array", "items": {"type": "object"}},
    "bundle_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
