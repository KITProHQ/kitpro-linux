{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitpro.us/schemas/install-spec-v1.schema.json",
  "title": "KITPro Linux installation specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "release", "system", "disk", "administrator"],
  "properties": {
    "version": { "const": 1 },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "generation"],
      "properties": {
        "name": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:-dev)?$" },
        "generation": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:-dev)?-g[0-9]{4}$" }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname"],
      "properties": {
        "hostname": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
        "locale": { "enum": ["C.UTF-8", "en_US.UTF-8"], "default": "C.UTF-8" },
        "timezone": { "type": "string", "default": "UTC" }
      }
    },
    "disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device"],
      "properties": {
        "device": { "type": "string", "pattern": "^/" },
        "target_type": { "enum": ["image", "block"], "default": "image" },
        "layout": {
          "enum": ["standard", "separate-home", "root-swap", "root-home-swap", "manual"],
          "default": "standard"
        },
        "filesystem": { "enum": ["ext4", "btrfs"], "default": "ext4" },
        "minimum_capacity_gib": { "type": "integer", "minimum": 6, "default": 6 },
        "storage": {
          "oneOf": [{
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version", "layout", "root_size_bytes", "swap_size_bytes",
            "logical_sector_bytes", "physical_sector_bytes"
          ],
          "properties": {
            "schema_version": { "const": 1 },
            "layout": {
              "enum": ["standard", "separate-home", "root-swap", "root-home-swap"]
            },
            "root_size_bytes": { "type": ["integer", "null"], "minimum": 5368709120 },
            "swap_size_bytes": { "type": ["integer", "null"], "minimum": 268435456 },
            "logical_sector_bytes": { "type": "integer", "minimum": 512 },
            "physical_sector_bytes": { "type": "integer", "minimum": 512 }
          }
          }, {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema_version", "layout", "root_size_bytes", "swap_size_bytes",
              "subvolumes", "compression", "logical_sector_bytes",
              "physical_sector_bytes", "filesystem"
            ],
            "properties": {
              "schema_version": { "const": 2 },
              "layout": {
                "enum": ["standard", "separate-home", "root-swap", "root-home-swap"]
              },
              "root_size_bytes": { "type": "null" },
              "swap_size_bytes": { "type": ["integer", "null"], "minimum": 268435456 },
              "subvolumes": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": { "enum": ["@", "@home", "@snapshots"] }
              },
              "compression": { "enum": ["none", "zstd"] },
              "logical_sector_bytes": { "type": "integer", "minimum": 512 },
              "physical_sector_bytes": { "type": "integer", "minimum": 512 },
              "filesystem": { "const": "btrfs" }
            }
          }, {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema_version", "layout", "subvolumes", "compression",
              "logical_sector_bytes", "physical_sector_bytes", "filesystem",
              "encryption"
            ],
            "properties": {
              "schema_version": { "const": 3 },
              "layout": { "enum": ["standard", "separate-home"] },
              "subvolumes": {
                "type": "array", "uniqueItems": true,
                "items": { "enum": ["@", "@home", "@snapshots"] }
              },
              "compression": { "enum": ["none", "zstd"] },
              "logical_sector_bytes": { "type": "integer", "minimum": 512 },
              "physical_sector_bytes": { "type": "integer", "minimum": 512 },
              "filesystem": { "enum": ["ext4", "btrfs"] },
              "encryption": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "schema_version", "enabled", "luks_version", "mapper_name",
                  "pbkdf", "keyslot", "iter_time_ms", "pbkdf_memory_kib",
                  "pbkdf_parallel_threads"
                ],
                "properties": {
                  "schema_version": { "const": 1 },
                  "enabled": { "const": true },
                  "luks_version": { "const": 2 },
                  "mapper_name": { "const": "cryptroot" },
                  "pbkdf": { "const": "argon2id" },
                  "keyslot": { "const": 0 },
                  "iter_time_ms": { "type": "integer", "minimum": 1000, "maximum": 5000 },
                  "pbkdf_memory_kib": { "type": "integer", "minimum": 65536, "maximum": 524288 },
                  "pbkdf_parallel_threads": { "type": "integer", "minimum": 1, "maximum": 4 }
                }
              }
            }
          }, {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema_version", "partitions", "subvolumes", "compression",
              "logical_sector_bytes", "physical_sector_bytes", "encryption"
            ],
            "properties": {
              "schema_version": { "const": 4 },
              "partitions": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "role", "filesystem", "mount_point", "size_bytes", "use_remaining"
                  ],
                  "properties": {
                    "role": { "enum": ["esp", "root", "home", "var", "srv", "swap"] },
                    "filesystem": { "enum": ["vfat", "ext4", "btrfs", "swap"] },
                    "mount_point": { "enum": ["/efi", "/", "/home", "/var", "/srv", null] },
                    "size_bytes": { "type": ["integer", "null"], "minimum": 268435456 },
                    "use_remaining": { "type": "boolean" }
                  }
                }
              },
              "subvolumes": {
                "type": "array", "uniqueItems": true,
                "items": { "enum": ["@", "@home", "@snapshots"] }
              },
              "compression": { "enum": ["none", "zstd"] },
              "logical_sector_bytes": { "type": "integer", "minimum": 512 },
              "physical_sector_bytes": { "type": "integer", "minimum": 512 },
              "encryption": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "schema_version", "enabled", "luks_version", "mapper_name",
                      "pbkdf", "keyslot", "iter_time_ms", "pbkdf_memory_kib",
                      "pbkdf_parallel_threads"
                    ],
                    "properties": {
                      "schema_version": { "const": 1 },
                      "enabled": { "const": true },
                      "luks_version": { "const": 2 },
                      "mapper_name": { "const": "cryptroot" },
                      "pbkdf": { "const": "argon2id" },
                      "keyslot": { "const": 0 },
                      "iter_time_ms": { "type": "integer", "minimum": 1000, "maximum": 5000 },
                      "pbkdf_memory_kib": { "type": "integer", "minimum": 65536, "maximum": 524288 },
                      "pbkdf_parallel_threads": { "type": "integer", "minimum": 1, "maximum": 4 }
                    }
                  }
                ]
              }
            }
          }]
        }
      }
    },
    "network": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": { "mode": { "const": "dhcp" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "address", "prefix", "gateway", "dns"],
          "properties": {
            "mode": { "const": "static" },
            "address": { "type": "string" },
            "prefix": { "type": "integer", "minimum": 1, "maximum": 32 },
            "gateway": { "type": "string" },
            "dns": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      ],
      "default": { "mode": "dhcp" }
    },
    "administrator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["username"],
      "properties": {
        "username": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,30}$" },
        "ssh_authorized_keys": { "type": "array", "items": { "type": "string" }, "default": [] },
        "password_hash": {
          "type": "string",
          "pattern": "^\\$y\\$[./A-Za-z0-9]+\\$[./A-Za-z0-9]+\\$[./A-Za-z0-9]+$",
          "description": "Optional precomputed yescrypt hash for unattended local-console login. Plaintext passwords are forbidden."
        }
      }
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean", "default": false } },
      "default": { "enabled": false }
    },
    "firewall": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "ssh": { "type": "boolean" } },
      "default": {}
    },
    "boot": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "mode": { "const": "uefi", "default": "uefi" } },
      "default": { "mode": "uefi" }
    }
  }
}
