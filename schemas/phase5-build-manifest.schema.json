{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitpro.us/schemas/phase5-build-manifest-v1.json",
  "title": "KITPro Linux Phase 5 media build manifest",
  "type": "object",
  "required": [
    "schema_version", "build_id", "status", "git_commit", "git_tree_state",
    "source_date_epoch", "worker_identity", "worker_capability_report_sha256",
    "archiso_version", "qemu_version", "firmware_version", "stable_generation",
    "generation_manifest_sha256", "package_artifact_set_sha256", "profile_sha256",
    "build_configuration_sha256", "installer_version", "installer_source_sha256",
    "iso_filename", "iso_path", "iso_size_bytes", "iso_sha256",
    "boot_mode_inspection", "build_method", "privilege_model", "build_start",
    "build_end", "build_duration_seconds"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "build_id": {"type": "string", "minLength": 1},
    "status": {"const": "passed"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "git_tree_state": {"const": "clean"},
    "source_date_epoch": {"type": "integer", "minimum": 1},
    "worker_identity": {"type": "object"},
    "worker_capability_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "archiso_version": {"type": "string"},
    "qemu_version": {"type": "string"},
    "firmware_version": {"type": "string"},
    "stable_generation": {"type": "string", "pattern": "^0\\.1-dev-g[0-9]{4}$"},
    "generation_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package_artifact_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "build_configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "installer_version": {"type": "string"},
    "installer_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "iso_filename": {"type": "string", "pattern": "\\.iso$"},
    "iso_path": {"type": "string"},
    "iso_size_bytes": {"type": "integer", "minimum": 1},
    "iso_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "boot_mode_inspection": {"enum": ["pending-static-verification", "uefi-only-verified"]},
    "build_method": {"const": "native-mkarchiso"},
    "privilege_model": {"enum": ["root", "unprivileged-userns"]},
    "build_start": {"type": "string"},
    "build_end": {"type": "string"},
    "build_duration_seconds": {"type": "number", "minimum": 0}
  },
  "additionalProperties": false
}
